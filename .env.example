# Copie este archivo como .env antes de ejecutar Docker Compose.
# Canal público de pruebas. Fije una versión numerada cuando exista una estable.
IMAGE_TAG=alpha

# Obligatorio: frase única de al menos 12 caracteres; se recomiendan 16 o más.
ADMIN_PASSWORD=CAMBIAR-por-una-frase-larga-y-unica

# Obligatorio: IP pública o DNS público, sin protocolo, puerto ni ruta.
SERVER_ENDPOINT=vpn.example.com

# Puerto UDP que debe coincidir en Docker, firewall, router y clientes.
SERVER_PORT=51820

# Red IPv4 exclusiva de la VPN; no debe solaparse con la LAN u otra VPN.
VPN_SUBNET=10.13.13.0/24

# DNS predeterminado para los peers.
PEER_DNS=1.1.1.1

# Full tunnel IPv4: todo el tráfico IPv4 del cliente pasa por la VPN.
CLIENT_ALLOWED_IPS=0.0.0.0/0

# Vacío permite que wg-quick determine el MTU automáticamente.
WG_MTU=

# La GUI se publica únicamente en 127.0.0.1 por defecto.
WEB_PORT=51821

# Zona horaria y propietario del volumen ./config.
TZ=America/Santiago
PUID=1000
PGID=1000

# Use true solamente al publicar la GUI detrás de HTTPS.
SESSION_COOKIE_SECURE=false
# 0 sin proxy; normalmente 1 si existe exactamente un proxy inverso confiable.
TRUSTED_PROXY_COUNT=0
