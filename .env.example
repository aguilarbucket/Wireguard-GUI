# Copie este archivo como .env y cambie todos los valores marcados.
# Etiqueta publicada en Docker Hub; use 0.2.0 para despliegues reproducibles.
IMAGE_TAG=0.2.0
ADMIN_PASSWORD=CAMBIAR-por-una-frase-larga-y-unica
SERVER_ENDPOINT=vpn.example.com
SERVER_PORT=51820
VPN_SUBNET=10.13.13.0/24
PEER_DNS=1.1.1.1
CLIENT_ALLOWED_IPS=0.0.0.0/0
# Vacío permite que wg-quick determine el MTU automáticamente.
WG_MTU=
WEB_PORT=51821
TZ=America/Santiago
PUID=1000
PGID=1000

# Active solamente al publicar la GUI detrás de HTTPS.
SESSION_COOKIE_SECURE=false
# Número de proxies inversos confiables delante de la aplicación (normalmente 1).
TRUSTED_PROXY_COUNT=0

# Cloudflare DDNS (servicio opcional: docker compose --profile ddns up -d)
DDNS_DOMAIN=vpn.example.com
